# ── Required: Subgraph API ──────────────────────────
# The Graph API key for the decentralized gateway (mainnet subgraph)
VITE_GRAPHQL_TOKEN="your-graph-api-key"

# Subgraph endpoints
VITE_SUBGRAPH_MAINNET=https://gateway.thegraph.com/api/subgraphs/id/ECENsJRfqi6Mwj6kF9diShPzFKkgyyo79aSCkSwAShHL
VITE_SUBGRAPH_GNOSIS=https://api.studio.thegraph.com/query/66145/klerosboard-gnosis/version/latest
VITE_SUBGRAPH_ARBITRUM=https://api.goldsky.com/api/public/project_cmgx9all3003atlp2bqha1zif/subgraphs/kleros-v2-coreneo/v0.17.2/gn

# ── Required: RPC providers ─────────────────────────
VITE_WEB3_MAINNET_PROVIDER_URL=https://0xrpc.io/eth
VITE_WEB3_GNOSIS_PROVIDER_URL=https://rpc.gnosis.gateway.fm
VITE_WEB3_POLYGON_PROVIDER_URL=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key
VITE_WEB3_ARBITRUM_PROVIDER_URL=https://arb1.arbitrum.io/rpc

# ── Optional: Kleros API (for dispute meta-evidence) ─
VITE_KLEROS_API_URL=https://kleros-api.netlify.app/.netlify/functions/get-dispute-metaevidence

# ── Optional: Curate subgraph (HyperIndex/Envio) ────
VITE_CURATE_SUBGRAPH=curate-subgraph

# ── Optional: Arbitrum v2 integration ───────────────
# Atlas indexer base URL for Arbitrum staking events
VITE_ATLAS_URI=https://atlas.staging.kleros.link
# SortitionModule contract address on Arbitrum (for Atlas queries)
VITE_ARBITRUM_SORTITION_MODULE=0x21A9402aDb818744B296e1d1BE58C804118DC03D

# ── Optional: Override stats API URL (defaults to local Netlify Functions) ──
# VITE_STATS_API_URL=/.netlify/functions/stats-

# ── Optional: Cloudflare (for deployment) ────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
