{
  "name": "klerosboard",
  "version": "3.0.0",
  "description": "The dashboard of Kleros Courts",
  "author": {
    "name": "Koki (https://github.com/salgozino)"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@apollo/client": "^4.0.0",
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@lingui/core": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^17.0.23",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "date-fns": "^4.4.0",
    "graphql": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6",
    "recharts": "^2.15.4",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.0",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@lingui/cli": "^6.4.0",
    "@lingui/format-po": "^6.4.0",
    "@lingui/macro": "^5.9.5",
    "@lingui/vite-plugin": "^6.4.0",
    "@netlify/functions": "^5.3.0",
    "@svgr/core": "^8.1.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "typescript-eslint": "^8",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-svgr": "^4.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "extract": "lingui extract --clean",
    "compile": "lingui compile",
    "lint": "eslint --fix --no-warn-ignored",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'yarn typecheck'"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependenciesMeta": {
    "v8-sandbox": {
      "built": false
    }
  },
  "volta": {
    "node": "24.2.0",
    "yarn": "4.9.1"
  }
}
